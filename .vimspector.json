{
  "configurations": {
    "Go: Launch FizzBuzz": {
      "adapter": "delve",
      "filetypes": ["go"],
      "configuration": {
        "request": "launch",
        "mode": "debug",
        "cwd": "${workspaceRoot}/apps/go",
        "program": "${workspaceRoot}/apps/go/cmd/fizzbuzz"
      }
    },
    "Go: Debug current test file": {
      "adapter": "delve",
      "filetypes": ["go"],
      "configuration": {
        "request": "launch",
        "mode": "test",
        "cwd": "${workspaceRoot}/apps/go",
        "program": "${fileDirname}"
      }
    }
  }
}
