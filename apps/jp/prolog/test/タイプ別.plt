% 題材 B: タイプ生成（なでしこ3 の test/type_test.nako3 に対応）
:- use_module('../src/タイプ別').

:- begin_tests(タイプ別).

test('タイプ1は通常の変換をする') :-
    タイプ生成(1, _タイプ),
    タイプ変換(_タイプ, 3, _結果),
    タイプ名前(_タイプ, _名前),
    assertion(_結果 == "Fizz"),
    assertion(_名前 == 通常).

test('タイプ2は数字だけを返す') :-
    タイプ生成(2, _タイプ),
    タイプ変換(_タイプ, 3, _結果),
    タイプ名前(_タイプ, _名前),
    assertion(_結果 == "3"),
    assertion(_名前 == 数字限定).

test('タイプ3は15の倍数だけFizzBuzzを返す') :-
    タイプ生成(3, _タイプ),
    タイプ変換(_タイプ, 15, _結果),
    assertion(_結果 == "FizzBuzz").

test('タイプ3は3の倍数を数字で返す') :-
    タイプ生成(3, _タイプ),
    タイプ変換(_タイプ, 3, _結果),
    assertion(_結果 == "3").

test('存在しないタイプはエラーになる',
     throws(タイプエラー("該当するタイプは存在しません: 4"))) :-
    タイプ生成(4, _).

:- end_tests(タイプ別).
