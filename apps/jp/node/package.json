{
  "name": "fizzbuzz-jp",
  "version": "0.1.0",
  "description": "日本語識別子による FizzBuzz（JavaScript と TypeScript）",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "lint": "eslint src/ test/",
    "format": "prettier --write \"src/**/*.{js,ts}\" \"test/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts}\" \"test/**/*.{js,ts}\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "typescript": "^5.7",
    "@types/node": "^24.0",
    "vitest": "^3.2",
    "eslint": "^9.0",
    "@typescript-eslint/parser": "^8.0",
    "@typescript-eslint/eslint-plugin": "^8.0",
    "eslint-config-prettier": "^10.0",
    "prettier": "^3.4"
  }
}
