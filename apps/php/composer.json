{
    "name": "fizzbuzz/php-tdd",
    "type": "project",
    "require": {
        "php": "^8.1"
    },
    "authors": [
        {
            "name": "Katuyuki Kakigi",
            "email": "kakimomokuri@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.1",
        "phpmd/phpmd": "^2.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "env -u PHP_INI_SCAN_DIR vendor/bin/phpunit",
        "test:coverage": "env -u PHP_INI_SCAN_DIR vendor/bin/phpunit --coverage-text",
        "lint": "env -u PHP_INI_SCAN_DIR vendor/bin/phpcs",
        "lint:fix": "env -u PHP_INI_SCAN_DIR vendor/bin/phpcbf",
        "format": "env -u PHP_INI_SCAN_DIR vendor/bin/phpcbf",
        "analyse": "env -u PHP_INI_SCAN_DIR vendor/bin/phpstan analyse",
        "complexity": "env -u PHP_INI_SCAN_DIR php -d error_reporting=24575 vendor/bin/phpmd src text phpmd.xml",
        "check": [
            "@lint",
            "@analyse",
            "@complexity",
            "@test"
        ]
    }
}
