{
  "configurations": {
    "Listen for Xdebug": {
      "adapter": "vscode-php-debug",
      "filetypes": [
        "php"
      ],
      "configuration": {
        "name": "Listen for Xdebug",
        "type": "php",
        "request": "launch",
        "port": 9003,
        "stopOnEntry": false
      }
    },
    "Debug current PHPUnit file": {
      "adapter": "vscode-php-debug",
      "filetypes": [
        "php"
      ],
      "configuration": {
        "name": "Debug current PHPUnit file",
        "type": "php",
        "request": "launch",
        "runtimeExecutable": "${workspaceRoot}/bin/php-debug",
        "program": "${workspaceRoot}/vendor/bin/phpunit",
        "args": [
          "${file}"
        ],
        "cwd": "${workspaceRoot}",
        "port": 9003,
        "runtimeArgs": [
          "-dxdebug.mode=debug",
          "-dxdebug.start_with_request=yes",
          "-dxdebug.client_host=127.0.0.1",
          "-dxdebug.client_port=9003"
        ],
        "stopOnEntry": true,
        "env": {
          "XDEBUG_MODE": "debug",
          "XDEBUG_TRIGGER": "VIMDEBUG",
          "XDEBUG_CONFIG": "client_host=127.0.0.1 client_port=9003 idekey=VIMDEBUG"
        }
      }
    },
    "Debug PHPUnit suite": {
      "adapter": "vscode-php-debug",
      "filetypes": [
        "php"
      ],
      "configuration": {
        "name": "Debug PHPUnit suite",
        "type": "php",
        "request": "launch",
        "runtimeExecutable": "${workspaceRoot}/bin/php-debug",
        "program": "${workspaceRoot}/vendor/bin/phpunit",
        "cwd": "${workspaceRoot}",
        "port": 9003,
        "runtimeArgs": [
          "-dxdebug.mode=debug",
          "-dxdebug.start_with_request=yes",
          "-dxdebug.client_host=127.0.0.1",
          "-dxdebug.client_port=9003"
        ],
        "stopOnEntry": true,
        "env": {
          "XDEBUG_MODE": "debug",
          "XDEBUG_TRIGGER": "VIMDEBUG",
          "XDEBUG_CONFIG": "client_host=127.0.0.1 client_port=9003 idekey=VIMDEBUG"
        }
      }
    },
    "Debug current standalone PHP file": {
      "adapter": "vscode-php-debug",
      "filetypes": [
        "php"
      ],
      "configuration": {
        "name": "Debug current standalone PHP file",
        "type": "php",
        "request": "launch",
        "runtimeExecutable": "${workspaceRoot}/bin/php-debug",
        "program": "${file}",
        "cwd": "${workspaceRoot}",
        "port": 9003,
        "runtimeArgs": [
          "-dxdebug.mode=debug",
          "-dxdebug.start_with_request=yes",
          "-dxdebug.client_host=127.0.0.1",
          "-dxdebug.client_port=9003"
        ],
        "stopOnEntry": true,
        "env": {
          "XDEBUG_MODE": "debug",
          "XDEBUG_TRIGGER": "VIMDEBUG",
          "XDEBUG_CONFIG": "client_host=127.0.0.1 client_port=9003 idekey=VIMDEBUG"
        }
      }
    }
  }
}
