# Rust プロジェクトのタスクランナー

# テスト実行
test:
    cargo test

# Clippy による静的解析
lint:
    cargo clippy -- -D warnings

# 複雑度チェック
complexity:
    cargo clippy -- -D clippy::cognitive_complexity

# コードフォーマット
fmt:
    cargo fmt

# フォーマットチェック
fmt-check:
    cargo fmt --check

# 全チェック実行（フォーマット → 静的解析 → 複雑度 → テスト）
check: fmt-check lint complexity test

# リリースビルド
build:
    cargo build --release

# 実行
run:
    cargo run

# ビルド成果物の削除
clean:
    cargo clean
